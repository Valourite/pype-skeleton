{
    "name": "pype/pype",
    "description": "Starter application for the pype framework.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "pype/framework": "^0.10.1",
        "phpmailer/phpmailer": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "@php bin/pype serve",
        "test": "phpunit",
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php bin/pype key:generate",
            "@php bin/pype migrate",
            "@php bin/pype install"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://github.com/Valourite/pype-skeleton",
    "keywords": [
        "framework",
        "pype",
        "starter",
        "skeleton"
    ]
}

APP_NAME=pype
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=                 # php bin/pype key:generate
#APP_PREVIOUS_KEYS=       # old keys while rotating (comma-separated)
APP_SERVER=fpm           # fpm | swoole (bin/pype serve runs OpenSwoole or Swoole; needs the openswoole or swoole extension)
# Any SWOOLE_* variable is a server setting (SWOOLE_PACKAGE_MAX_LENGTH=16777216); see config/app.php.
#SWOOLE_WORKERS=         # default 1 per CPU core (the container's limit, if any)
#SWOOLE_MODE=base        # base | process (process: a worker restart doesn't drop keep-alive connections)
#SWOOLE_MAX_REQUEST=100000  # recycle each worker after this many requests (0 = never)
#SWOOLE_STATIC_HANDLER=  # true: the server's own static handler (off: it stalled keep-alive responses, see GUIDE)

# Database: sqlite | mysql | pgsql
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# sqlite only: any SQLITE_* variable is a pragma (defaults: WAL, synchronous NORMAL, busy_timeout 5000)
#SQLITE_BUSY_TIMEOUT=5000
#SQLITE_SYNCHRONOUS=NORMAL
# mysql / pgsql only:
#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_SOCKET=              # unix socket (mysql) or its directory (pgsql); faster than TCP on one box
#DB_USERNAME=root
#DB_PASSWORD=
#DB_PERSISTENT=false     # reuse connections across requests

# Sessions: database | file | array
SESSION_DRIVER=database
SESSION_SECURE=false     # true in production (HTTPS-only cookie)

# Cache: file (default) | apcu (fastest; needs the apcu extension, one server) | database | array | null
CACHE_DRIVER=file

# Queue: sync (jobs run right away; development) | database (production: run `php bin/pype queue:work`)
QUEUE_DRIVER=sync

# JWT (only with Pype\Auth\JwtGuard in config/auth.php)
#JWT_SECRET=                 # 32+ random bytes: php -r 'echo bin2hex(random_bytes(32));'
#JWT_PUBLIC_KEY=             # RS256: the identity provider's public key (PEM)

# Logging: storage/logs/pype-YYYY-MM-DD.log; viewer at /_pype/logs (see config/log.php)
LOG_LEVEL=debug
#LOG_FORWARD=stderr       # also send to: stderr, stdout, syslog (comma-separated); classes in config/log.php
#LOG_FORWARD_LEVEL=warning
#LOG_REQUESTS=true        # default: on when APP_DEBUG=true
#LOG_VIEWER=true          # default: on when APP_DEBUG=true; production also needs log.viewer.stages

# Mail: log (default: emails go to the log) | smtp | sendmail | mail | array | null
MAIL_DRIVER=log           # log = nothing is delivered; read sent mail at /_pype/mail (APP_DEBUG)
#MAIL_MAILBOX=true        # the dev mailbox; default: APP_DEBUG
#MAIL_HOST=smtp.example.com
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_ENCRYPTION=tls      # tls (587) | ssl (465) | none (local Mailpit on port 1025)
MAIL_FROM_ADDRESS=hello@example.com
#MAIL_FROM_NAME=          # default: APP_NAME

# Throttle counters: database | apcu (needs the apcu extension; one server only)
RATE_LIMIT_DRIVER=database
